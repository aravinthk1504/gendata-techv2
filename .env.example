# Example configuration only. NEVER commit real keys or .env.local.
# Development credentials use a local JSON file outside the repository.
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json

# Firebase Authentication
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
ADMIN_UIDS=comma-separated-approved-firebase-auth-uids

# Generate a strong 32+ character random value for the contact limiter.
RATE_LIMIT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters

# Existing Cloudinary account (server only).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Enable only after Resend has verified the sending domain.
RESEND_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=your-resend-key
RESEND_FROM_EMAIL="GenData Tech <enquiries@your-verified-domain.example>"
RESEND_NOTIFY_TO=your-management-mailbox@example.com

# Optional customer receipt (disabled by default until abuse checks are ready).
RESEND_CUSTOMER_ACK_ENABLED=false
# Customer sender is independent of the management sender.
RESEND_CUSTOMER_FROM_EMAIL="GenData Tech <noreply@your-verified-domain.example>"
RESEND_CUSTOMER_REPLY_TO=support@your-verified-domain.example
# Optional public HTTPS PNG/JPEG logo. Otherwise existing WebP embedded via CID.
# RESEND_EMAIL_LOGO_URL=https://example.com/gendata-logo.png

# Firebase App Hosting uses its workload identity/application-default
# credentials; do not set GOOGLE_APPLICATION_CREDENTIALS on App Hosting.

# Cloudflare Turnstile for public contact form.
# Production requires all three variables or contact submissions fail closed.
TURNSTILE_SITE_KEY=your-public-site-key
TURNSTILE_SECRET_KEY=your-private-server-secret
# Exact comma-separated hostnames only. Add Firebase staging hostname while testing.
TURNSTILE_ALLOWED_HOSTNAMES=gendatatech.com,www.gendatatech.com
# Optionally exercise Turnstile during local dev (off by default locally).
# CONTACT_TURNSTILE_REQUIRED=true

# Local testing: with either Turnstile key set, the contact widget is shown.
# Leave CONTACT_TURNSTILE_REQUIRED unset to auto-enable from keys.
# Set CONTACT_TURNSTILE_REQUIRED=false to temporarily disable it in dev only.
# For isolated local testing, Cloudflare's documented always-pass keys:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_ALLOWED_HOSTNAMES=localhost
# Never use test keys for production: the server explicitly rejects them.
